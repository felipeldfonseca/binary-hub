# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your-project-url.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Anthropic API for Market Analysis (required for /market page live data)
ANTHROPIC_API_KEY=sk-ant-...

# Accounts allowed to call endpoints that spend the AI budget (comma-separated
# emails or Supabase user ids). Sign-up is open, so with this unset nobody can.
AI_ALLOWED_USERS=

# Accounts allowed into the new hub screens (/diario and the ones that follow)
# while they are being built: comma-separated emails or Supabase user ids.
# With this unset nobody gets in.
HUB_USERS=

# The daily agenda load (/api/cron/agenda, Vercel's cron at 09:00 UTC). Set by hand in the
# Vercel project (Production) only; never in a file, a chat or GitHub. CRON_SECRET is a long
# random string Vercel sends as «Authorization: Bearer …»; the service-role key is the
# Supabase server key (it bypasses row-level security; the cron route alone uses it).
CRON_SECRET=
SUPABASE_SERVICE_ROLE_KEY=
