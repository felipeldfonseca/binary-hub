# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your-project-url.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Anthropic API for Market Analysis (required for /market page live data)
ANTHROPIC_API_KEY=sk-ant-...

# Accounts allowed to call endpoints that spend the AI budget (comma-separated
# emails or Supabase user ids). Sign-up is open, so with this unset nobody can.
AI_ALLOWED_USERS=

# Accounts allowed into the new hub screens (/diario and the ones that follow)
# while they are being built: comma-separated emails or Supabase user ids.
# With this unset nobody gets in.
HUB_USERS=
